[Unit]
Description=Airfoils.Pro bounded deployment-source and Docker cleanup
Documentation=https://github.com/holyglory/XFoilFOAM
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
Environment=DOCKER_PRUNE_RETENTION_HOURS=72
Environment=DOCKER_BUILD_CACHE_KEEP_STORAGE=10GB
Environment=DEPLOYMENT_RELEASE_KEEP_COUNT=3
Environment=DEPLOYMENT_STAGING_MAX_AGE_HOURS=24
ExecStart=/usr/local/sbin/airfoils-docker-storage-prune
Nice=10
IOSchedulingClass=idle
IOSchedulingPriority=7
TimeoutStartSec=1h

[Install]
WantedBy=multi-user.target
