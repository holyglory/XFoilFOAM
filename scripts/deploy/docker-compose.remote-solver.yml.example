# Install as /opt/airfoils-pro/state/docker-compose.remote-solver.yml on
# hz-solver2. The deployment environment points COMPOSE_OVERRIDE_FILE at that
# external, release-independent path. Do not add GCS credentials here.
services:
  api:
    environment:
      AIRFOILFOAM_EVIDENCE_BUCKET: ""
      AIRFOILFOAM_EVIDENCE_OBJECT_PREFIX: solver-evidence/v1
      AIRFOILFOAM_EVIDENCE_ZSTD_LEVEL: "10"
      AIRFOILFOAM_EVIDENCE_REMOTE_ONLY: "false"

  worker:
    environment:
      AIRFOILFOAM_EVIDENCE_BUCKET: ""
      AIRFOILFOAM_EVIDENCE_OBJECT_PREFIX: solver-evidence/v1
      AIRFOILFOAM_EVIDENCE_ZSTD_LEVEL: "10"
      AIRFOILFOAM_EVIDENCE_REMOTE_ONLY: "false"
      AIRFOILFOAM_WORKER_CPU_BUDGET: ${AIRFOILFOAM_WORKER_CPU_BUDGET:?set AIRFOILFOAM_WORKER_CPU_BUDGET}
      AIRFOILFOAM_CASE_CONCURRENCY: ${AIRFOILFOAM_CASE_CONCURRENCY:?set AIRFOILFOAM_CASE_CONCURRENCY}
      AIRFOILFOAM_CELERY_CONCURRENCY: ${AIRFOILFOAM_CELERY_CONCURRENCY:?set AIRFOILFOAM_CELERY_CONCURRENCY}
    deploy:
      resources:
        limits:
          cpus: "${AIRFOILFOAM_WORKER_CPU_BUDGET:?set AIRFOILFOAM_WORKER_CPU_BUDGET}"

  sweeper:
    environment:
      AIRFOILFOAM_EVIDENCE_BUCKET: ""
      AIRFOILFOAM_EVIDENCE_REMOTE_ONLY: "false"
      AIRFOILFOAM_WORKER_CPU_BUDGET: ${AIRFOILFOAM_WORKER_CPU_BUDGET:?set AIRFOILFOAM_WORKER_CPU_BUDGET}

  media-repair:
    environment:
      AIRFOILFOAM_EVIDENCE_BUCKET: ""
      AIRFOILFOAM_EVIDENCE_REMOTE_ONLY: "false"
