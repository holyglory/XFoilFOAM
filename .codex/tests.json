{
  "schema_version": 3,
  "defaults": {
    "timeout_seconds": 7200,
    "network": "external",
    "environment": {
      "CI": "true",
      "NEXT_TELEMETRY_DISABLED": "1",
      "PYTHONDONTWRITEBYTECODE": "1",
      "PYTHONHASHSEED": "0"
    }
  },
  "global_inputs": [
    ".codex/tests.json",
    ".codex/devcoordinator_test_harness.py",
    ".npmrc",
    "AGENTS.md",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "pyproject.toml",
    "tsconfig.base.json",
    "uv.lock"
  ],
  "intents": {
    "change": {
      "source_mode": "live",
      "allow_reuse": false
    },
    "checkpoint": {
      "source_mode": "live",
      "allow_reuse": false
    },
    "handoff": {
      "source_mode": "immutable",
      "allow_reuse": true
    },
    "release": {
      "source_mode": "immutable",
      "allow_reuse": false
    },
    "manual": {
      "source_mode": "immutable",
      "allow_reuse": false
    }
  },
  "fixtures": {},
  "targets": {
    "python-suite": {
      "driver": "automation",
      "reporter": "automation-events",
      "cwd": ".",
      "argv": [
        "{python}",
        ".codex/devcoordinator_test_harness.py",
        "python-suite"
      ],
      "inputs": [
        ".codex/devcoordinator_test_harness.py",
        "src/**",
        "tests/**",
        "scripts/**/*.py",
        "pyproject.toml",
        "uv.lock"
      ],
      "depends_on": [],
      "intents": ["change", "checkpoint", "handoff", "release", "manual"],
      "retry": {
        "max_attempts": 2,
        "retry_on": ["lease_expired_before_launch"]
      },
      "network": "external"
    },
    "node-suite": {
      "driver": "automation",
      "reporter": "automation-events",
      "cwd": ".",
      "argv": [
        "{python}",
        ".codex/devcoordinator_test_harness.py",
        "node-suite"
      ],
      "inputs": [
        ".codex/devcoordinator_test_harness.py",
        "apps/**",
        "packages/**",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "tsconfig.base.json"
      ],
      "depends_on": [],
      "intents": ["change", "checkpoint", "handoff", "release", "manual"],
      "retry": {
        "max_attempts": 2,
        "retry_on": ["lease_expired_before_launch"]
      },
      "network": "external"
    },
    "urans-recovery-regression": {
      "driver": "automation",
      "reporter": "automation-events",
      "cwd": ".",
      "environment": {
        "DATABASE_URL": "postgres://aerodb:aerodb@127.0.0.1:5544/aerodb"
      },
      "argv": [
        "{python}",
        ".codex/devcoordinator_test_harness.py",
        "urans-recovery-regression"
      ],
      "inputs": [
        ".codex/devcoordinator_test_harness.py",
        "apps/api/src/services/solver-work.ts",
        "apps/api/test/solver-work.test.ts",
        "apps/api/test/point-history.test.ts",
        "apps/api/test/sync-fast-budget.test.ts",
        "apps/sweeper/src/**",
        "apps/sweeper/test/build-request-transient-pin.test.ts",
        "apps/sweeper/test/fidelity-contract-pin.test.ts",
        "apps/sweeper/test/urans-quality-recovery.test.ts",
        "apps/sweeper/test/urans-ladder.test.ts",
        "apps/sweeper/test/point-correction-fast-budget.test.ts",
        "apps/sweeper/test/point-correction-fairness.test.ts",
        "apps/web/lib/solver-state.ts",
        "apps/web/components/admin/campaigns/campaign-status.ts",
        "apps/web/test/solver-state.test.ts",
        "apps/web/test/campaign-status-line.test.ts",
        "packages/core/src/**",
        "packages/core/test/aperiodic-mean-certificate.test.ts",
        "packages/core/test/aperiodic-mean-classifier.test.ts",
        "packages/core/test/precalc-recovery-policy.test.ts",
        "packages/db/src/**",
        "packages/db/test/precalc-contract-remediation.test.ts",
        "packages/db/test/point-correction-fast-budget-migration.test.ts",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "tsconfig.base.json"
      ],
      "depends_on": [],
      "intents": ["change", "checkpoint", "handoff", "release", "manual"],
      "retry": {
        "max_attempts": 2,
        "retry_on": ["lease_expired_before_launch"]
      },
      "network": "external"
    },
    "sync-remote-validation-regression": {
      "driver": "automation",
      "reporter": "automation-events",
      "cwd": ".",
      "environment": {
        "DATABASE_URL": "postgres://aerodb:aerodb@127.0.0.1:5544/aerodb"
      },
      "argv": [
        "{python}",
        ".codex/devcoordinator_test_harness.py",
        "sync-remote-validation-regression"
      ],
      "inputs": [
        ".codex/devcoordinator_test_harness.py",
        "apps/api/src/sync-routes.ts",
        "apps/api/test/sync-remote-validation.test.ts",
        "apps/sweeper/src/remote-solver.ts",
        "apps/sweeper/test/remote-solver-validation.test.ts",
        "packages/core/src/**",
        "packages/db/src/**",
        "packages/db/test/campaign-remediation-summary.test.ts",
        "packages/engine-client/src/**",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "tsconfig.base.json"
      ],
      "depends_on": [],
      "intents": ["change", "checkpoint", "handoff", "release", "manual"],
      "retry": {
        "max_attempts": 2,
        "retry_on": ["lease_expired_before_launch"]
      },
      "network": "external"
    }
  },
  "evidence_policies": {
    "handoff": {
      "intent": "handoff",
      "required_targets": ["python-suite", "node-suite"],
      "max_age_seconds": 86400,
      "allow_reuse": true
    },
    "release": {
      "intent": "release",
      "required_targets": ["python-suite", "node-suite"],
      "max_age_seconds": 3600,
      "allow_reuse": false
    }
  }
}
